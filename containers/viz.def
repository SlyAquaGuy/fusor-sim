Bootstrap: localimage
From: sif/analysis.sif

# Visualisation component: the analysis image plus ffmpeg for the ion movie.
%post
    # EPEL's ffmpeg-free needs ladspa (via rubberband), which is in CRB
    dnf -y install epel-release dnf-plugins-core && dnf config-manager --set-enabled crb
    dnf -y install ffmpeg-free && dnf clean all

%environment
    export MPLBACKEND=Agg

%runscript
    exec fusor-viz "$@"

%test
    ffmpeg -version | head -1

%labels
    Component viz
